        <mxCell id="notes_box" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#E6B8B7;" vertex="1" parent="1">
          <mxGeometry x="1330" y="700" width="340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="notes_h" value="WAREHOUSING DESIGN DECISIONS" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#7B2D26;" vertex="1" parent="1">
          <mxGeometry x="1346" y="708" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="notes_b" value="&#8226; Star schema, not snowflaked: dim_employee carries DepartmentID + DepartmentName and dim_project carries the manager's ID + name, so there is no sub-dimension.&#10;&#8226; Surrogate keys everywhere. The fact joins on BIGINT / INT only, so no CHAR business key spans the star and no implicit conversion can disable index use.&#10;&#8226; Degenerate dimension: ReviewID stays on the fact, since it identifies the transaction but has no dimension of its own.&#10;&#8226; Snapshot measures (AttritionFlag, TenureYears, AllocationPercentage) are resolved from the point-in-time employee version at review time, which is what makes attrition risk historically accurate.&#10;&#8226; dim_date is populated by a recursive CTE (2018-01-01 to 2026-12-31, ~3,287 days) and is idempotent - it only fills gaps.&#10;&#8226; LoadBatchID provides row-level lineage back to the ETL run that wrote each fact row." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1346" y="732" width="308" height="260" as="geometry" />
        </mxCell>

        <mxCell id="scd_note_box" value="" style="rounded=0;html=1;fillColor=#FFFBF0;strokeColor=#FFD966;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="scd_note_h" value="SCD TYPE 2 SEMANTICS IN dim_employee" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="76" y="158" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="scd_note_b" value="One row per employee PER VERSION. EmployeeSK is the surrogate key the fact table points at, so a promotion or transfer inserts a new version instead of overwriting the old one.&#10;&#8226; A change closes the open version (EffectiveEndDate = new start - 1 day, IsCurrent = 0) and inserts the new one in the same UPDATE/INSERT pair.&#10;&#8226; Invariant: exactly one IsCurrent = 1 row per EmployeeID; older versions always have a non-NULL EffectiveEndDate.&#10;&#8226; Tracked attributes: DepartmentID / DepartmentName, JobRole, JobLevel, MonthlyIncome." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="76" y="182" width="528" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>