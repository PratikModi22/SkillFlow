        <mxCell id="e_scd_note" value="The fact row picks the dim_employee version whose [EffectiveStartDate, EffectiveEndDate] window contains ReviewDate, so a review stays attributed to the department the employee held AT REVIEW TIME - not their current one." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#C00000;fillColor=#FFF4F4;strokeColor=#E6B8B7;rounded=0;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="640" width="200" height="150" as="geometry" />
        </mxCell>

