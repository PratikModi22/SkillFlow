        <mxCell id="e_date_fact" value="fk_fact_date&#10;DateSK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#376092;strokeWidth=2;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0.35;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;fontSize=11;fontColor=#376092;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t_dim_date" target="t_fact">
          <mxGeometry relative="1" as="geometry" />
