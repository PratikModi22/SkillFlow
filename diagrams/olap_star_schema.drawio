          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_proj_note" value="is not tied to a project - optional conformed dimension." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#7030A0;" vertex="1" parent="1">
          <mxGeometry x="1150" y="640" width="210" height="50" as="geometry" />
